APP_NAME="Enterprise AI Operations Agent"
ENVIRONMENT=development
LOG_LEVEL=INFO
# Host binding only; use an available port such as 18001 if Windows reserves 8000.
APP_PORT=8000

# For Docker copy this file to ignored .env.docker; for host Python use .env.
# Use three different URL-safe passwords (for example random hexadecimal strings).
POSTGRES_PASSWORD=replace_with_a_local_password
# Containers use postgres:5432. Host Python uses localhost:5432 instead.
# Compose requires DATABASE_URL; bare Python /health still needs no database.
# Keep the primary password consistent with POSTGRES_PASSWORD; URL-encode URL values.
DATABASE_URL=postgresql+psycopg://enterprise_ai_ops_app:replace_with_a_local_password@postgres:5432/enterprise_ai_ops_agent

# Guarded analytics only: a separate password and login; no fallback to DATABASE_URL.
# Configure locally, then explicitly run db.provision_analytics_role as documented.
ANALYTICS_DATABASE_URL=postgresql+psycopg://enterprise_ai_ops_reader:replace_with_a_separate_local_password@postgres:5432/enterprise_ai_ops_agent

# Only AI commands require a key. Set it in the ignored local .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Demo protected workflow API only; set a random secret in ignored local configuration.
# This shared key authorizes a source, not an individual employee identity.
APPROVAL_API_KEY=

# Knowledge-only retrieval role, explicitly provisioned after the knowledge migration.
KNOWLEDGE_DATABASE_URL=postgresql+psycopg://enterprise_ai_ops_knowledge_reader:replace_with_a_separate_password@postgres:5432/enterprise_ai_ops_agent
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Fixed by the current vector schema; changing dimensions requires a migration.
OPENAI_EMBEDDING_DIMENSIONS=1536
